{
  "name": "@local/sidebar-entry-toggle",
  "version": "1.1.2",
  "description": "在设置中增加一个分区，自动列出侧栏所有入口（含新安装的插件），用独立开关控制显示与隐藏、拖动调整顺序。升级后无需手动维护白名单，新装插件自动纳入管理。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
